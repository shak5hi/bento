# Bento on a server: copy to backend/.env and fill in. Never commit the filled-in file.
# Make random values with:  openssl rand -hex 32

# The address Bento lives at (an A record pointing at the server)
BENTO_DOMAIN=

# Required secrets (long random strings; the stack won't start without them)
POSTGRES_PASSWORD=
JWT_SECRET=

# GitHub App: same values as on your laptop, with the app's URLs changed to https://BENTO_DOMAIN
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# the .pem on one line:  awk 'NF {printf "%s\\n", $0}' your-key.pem
GITHUB_APP_PRIVATE_KEY=

# Email (Resend). EMAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
DIGEST_TIMEZONE=Asia/Kolkata
DIGEST_HOUR=8

# Pickle's local model. The free Oracle server has room for a stronger one than a laptop.
PICKLE_MODEL=qwen2.5:3b

# Optional
SLACK_WEBHOOK_URL=
