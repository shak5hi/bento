# Copy to .env (in this backend/ folder) and fill in what you need. Never commit the filled-in file.
#
# On your laptop every value has a development default, so `docker compose up --build` works without a .env.
# On a server (docker-compose.prod.yml, see deploy/README.md) BENTO_DOMAIN, POSTGRES_PASSWORD and JWT_SECRET
# are required: the stack refuses to start without them.
# Make random values with:  openssl rand -hex 32

# ---- Server only ----
# The address Bento lives at (an A record pointing at the server), e.g. bento.yourname.me
BENTO_DOMAIN=

# ---- Secrets (leave empty on a laptop to use the dev defaults; required on a server) ----
POSTGRES_USER=bento
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_TTL_HOURS=168

# Where browsers reach Bento (GitHub redirects back here after sign-in). On a server it's set from BENTO_DOMAIN.
PUBLIC_URL=http://localhost:8080

# ---- GitHub App: "Sign in with GitHub", private repos, scans, PR checks, fix PRs ----
# Create the app at https://github.com/settings/apps/new (steps in backend/README.md, "Connect GitHub").
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The app's private key (.pem) on one line, each newline written as \n:  awk 'NF {printf "%s\\n", $0}' key.pem
GITHUB_APP_PRIVATE_KEY=
# Same value as the app's "Webhook secret"
GITHUB_WEBHOOK_SECRET=

# ---- Email: incident alerts, the welcome report and the Monday digest ----
# Free option: a Gmail account. Turn on 2-Step Verification, then make an app password at
# https://myaccount.google.com/apppasswords and paste it here (the 16 letters, no spaces).
# When these are set Bento sends through Gmail and ignores the Resend settings below.
SMTP_USER=
SMTP_PASSWORD=
# Or Resend (needs a domain you own to email anyone but yourself):
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. Bento <alerts@yourname.me>
EMAIL_FROM=
DIGEST_TIMEZONE=Asia/Kolkata
DIGEST_HOUR=8

# ---- Pickle's local model (Ollama). Empty OLLAMA_URL = rule-based text only ----
# qwen2.5:1.5b suits a laptop; a server with 8 GB+ can run qwen2.5:3b
PICKLE_MODEL=qwen2.5:1.5b

# ---- Optional ----
# Also post incident alerts to Slack
SLACK_WEBHOOK_URL=

# Host ports (laptop)
FRONTEND_PORT=8080
FRONTEND_DEV_PORT=4000
GATEWAY_PORT=8081

# Probe pipeline
PROBER_REPLICAS=2
PROBE_INTERVAL_SECONDS=60
# true only for local testing (lets Bento probe localhost / private IPs)
ALLOW_PRIVATE_TARGETS=false

# Browser origins allowed to call the gateway directly (not needed via :8080; set from BENTO_DOMAIN on a server)
CORS_ORIGINS=http://localhost:8080,http://localhost:4000
