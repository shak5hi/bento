# Copy to .env (in this backend/ folder) and adjust. Every value has a dev default,
# so `docker compose up --build` works without a .env file.

# Host ports
FRONTEND_PORT=8080
FRONTEND_DEV_PORT=4000
GATEWAY_PORT=8081

# Postgres + TimescaleDB credentials
POSTGRES_USER=bento
POSTGRES_PASSWORD=change-me

# Auth — use a long random string in any shared or deployed environment
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=168

# GitHub push webhooks -> repo scans. Same value as in the GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=

# Optional: also post incident alerts to Slack
SLACK_WEBHOOK_URL=

# Probe pipeline
PROBER_REPLICAS=2
PROBE_INTERVAL_SECONDS=60
# true only for local testing (lets Bento probe localhost / private IPs)
ALLOW_PRIVATE_TARGETS=false

# Browser origins allowed to call the gateway directly (not needed via :8080)
CORS_ORIGINS=http://localhost:8080,http://localhost:4000
