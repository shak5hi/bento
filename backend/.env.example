# ─── Supabase (Shared) ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # never expose this client-side

# ─── GitHub Integration (Shakshi) ───────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/integrations/github/callback
GITHUB_WEBHOOK_SECRET=your-random-webhook-secret  # used to verify GitHub webhook payloads

# ─── Vercel Integration (Shakshi) ───────────────────────────────────────────
# Users paste their own Vercel API token in-app; this key is the Bento service account
VERCEL_API_TOKEN=your-vercel-api-token

# ─── Sentry Integration (Shakshi) ───────────────────────────────────────────
# Users paste their own Sentry auth token in-app; this key is the Bento service account
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG_SLUG=your-sentry-org-slug

# ─── AI / Anthropic (Lavanya) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key           # Claude Haiku — cheapest model

# ─── Email / Resend (Lavanya) ───────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=reports@yourdomain.com

# ─── App Config (Shared) ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4000              # used for CORS + OAuth redirect
JWT_SECRET=your-jwt-secret                     # used for signing any custom tokens
