# Caddy: the public front door. Gets and renews HTTPS certificates for BENTO_DOMAIN by itself.
# Everything goes to the frontend's nginx, which serves the app and proxies /api to the gateway.
{$BENTO_DOMAIN} {
	encode zstd gzip
	reverse_proxy frontend:80

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
